[TEMPLATE]

# ── Required ────────────────────────────────────────────────────────────

# Gemini API key for AI features (chat, summaries, chart generation).
# Get one free at: https://aistudio.google.com/apikey
# The app runs without it — only AI features are unavailable.
GEMINI_API_KEY=your_api_key_here

# ── Optional — all have sensible defaults ──────────────────────────────

# OAuth redirect URI for Google sign-in.
# Default: http://localhost:8501 (set this when deploying to a different URL).
# OAUTH_REDIRECT_URI=http://localhost:8501

# Path to your downloaded Google OAuth client secret JSON file.
# Default: client_secrets.json in the project root.
# Only set this if you store the file elsewhere.
# GA4_CLIENT_SECRETS_PATH=

# Directory for temporary OAuth state files (PKCE code verifiers).
# Default: system temp directory (safe to leave unset).
# GA4_OAUTH_STATE_DIR=

# Enable full error details in the app UI (development only).
# Default: false (production mode — generic error messages).
# Never set true in a deployed environment.
# SHOW_DEBUG_DETAILS=false

# ── FastAPI migration backend (Phase 1) ─────────────────────────────────
# Names are allowlist-validated by scripts/check_credentials.py (names only,
# master-plan §11-D). API_SESSION_SECRET must stay a placeholder here — real
# values belong in deployment secrets or your untracked local .env.
API_SESSION_SECRET=replace-with-a-long-random-value   # python -c "import secrets; print(secrets.token_urlsafe(48))"
API_CORS_ORIGINS=http://localhost:5173                 # Vite dev origin; same-origin deploy -> empty
FRONTEND_URL=http://localhost:5173
MAX_BROWSER_UPLOAD_BYTES=26214400                      # 25 MB = 25 * 1024 * 1024 (locked)
MAX_INGEST_BYTES=104857600                             # 100 MB = 100 * 1024 * 1024 (Drive/server-side only)

# ── Phase 3: AI / Gemini runtime ────────────────────────────────────────────
# Names are allowlist-validated by scripts/check_credentials.py (names only;
# canonical policy: policies/data-retention-policy.md §7.1-7.2). GEMINI_API_KEY
# (top of file) is the only AI secret — it must stay a placeholder here.
GEMINI_MODEL=gemini-2.5-flash                          # allowlisted; 3.5-flash / 3.5-flash-lite also registered
GEMINI_DATA_POLICY=local_free                          # local_free | client_paid | disabled — never inferred from key
AI_MAX_INPUT_TOKENS=24000                              # heuristic input budget (chars/4 estimate)
AI_RESERVED_OUTPUT_TOKENS=4096                         # output reserve; input budget = MAX - RESERVED
AI_MAX_CONTEXT_CHARS=96000                             # deterministic-context cap before trimming
AI_FIRST_TOKEN_TIMEOUT_SECONDS=30                      # no first token -> cancel + typed timeout
AI_GENERATE_TIMEOUT_SECONDS=60                         # non-streaming generation cap
AI_STREAM_TIMEOUT_SECONDS=120                          # full stream cap
