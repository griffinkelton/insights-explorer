[TEMPLATE]

# ── Required ────────────────────────────────────────────────────────────

# Gemini API key for AI features (chat, summaries, chart generation).
# Get one free at: https://aistudio.google.com/apikey
# The app runs without it — only AI features are unavailable.
GEMINI_API_KEY=your_api_key_here

# ── Optional — all have sensible defaults ──────────────────────────────

# OAuth redirect URI for Google sign-in.
# Default: http://localhost:8501 (set this when deploying to a different URL).
# OAUTH_REDIRECT_URI=http://localhost:8501

# Path to your downloaded Google OAuth client secret JSON file.
# Default: client_secrets.json in the project root.
# Only set this if you store the file elsewhere.
# GA4_CLIENT_SECRETS_PATH=

# Directory for temporary OAuth state files (PKCE code verifiers).
# Default: system temp directory (safe to leave unset).
# GA4_OAUTH_STATE_DIR=

# Enable full error details in the app UI (development only).
# Default: false (production mode — generic error messages).
# Never set true in a deployed environment.
# SHOW_DEBUG_DETAILS=false
